---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import { postSlug, sortVersions } from '@/lib/posts';

export async function getStaticPaths() {
  const [posts, versions] = await Promise.all([
    getCollection('blog'),
    getCollection('blogVersions'),
  ]);

  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: postSlug(post) },
      props: {
        post,
        versions: sortVersions(
          versions.filter(
            (version) => !version.data.draft && version.data.post === postSlug(post),
          ),
        ),
      },
    }));
}

const { post, versions } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout post={post} versions={versions}>
  <Content />
</BlogPostLayout>
