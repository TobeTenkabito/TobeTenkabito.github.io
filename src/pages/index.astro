---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import { categoryHref, postHref } from '@/lib/posts';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 4);

const now = [
  '把旧笔记慢慢搬到这里，不急着做成很完整的教程。',
  '记录项目里那些后来才想明白的判断。',
  '希望这个地方更像书桌，而不是展示橱窗。',
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">个人博客</p>
      <h1>{site.title}</h1>
      <p>
        Tenkabito是天下人（てんかびと）的音注
        不过现在看来这个梦想有点遥远呢
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/blog/">看最近写了什么</a>
        <a class="button secondary" href="/about/">关于这个站</a>
      </div>
    </div>

    <aside class="now-note" aria-label="最近状态">
      <p class="eyebrow">Now</p>
      <h2>最近在整理</h2>
      <ul>
        {now.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </section>

  <figure class="desk-snapshot">
    <picture>
      <source srcset="/images/desk-note.webp" type="image/webp" />
      <img src="/images/blog-hero.png" alt="桌面上的笔记本、咖啡和电脑" width="820" height="454" />
    </picture>
    <figcaption>无人在意且随意放置的图片</figcaption>
  </figure>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">最近文章</p>
        <h2>新写下来的</h2>
      </div>
      <a class="text-link" href="/blog/">全部文章</a>
    </div>
    <div class="post-grid">
      {
        posts.map((post) => (
          <article class="post-card">
            <p class="post-date">
              {post.data.publishDate.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
              <span> / </span>
              <a href={categoryHref(post.data.category)}>{post.data.category}</a>
            </p>
            <h3><a href={postHref(post)}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <ul class="tag-list">
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section split">
    <div>
      <p class="eyebrow">这是什么</p>
      <h2>思考的过程和结果必须被重视</h2>
    </div>
    <div class="feature-list">
      <p>技术笔记：尽量写清楚背景、取舍和最后能复用的结论。</p>
      <p>游戏感想：好的游戏如同一部好的艺术，小说可以复看，但是游戏周回却很费时间。</p>
      <p>一些思考：经验和想法必须记录，以及在日后不断被修正，否则错误会积累。</p>
    </div>
  </section>
</BaseLayout>
