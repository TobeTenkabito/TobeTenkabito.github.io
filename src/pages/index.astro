---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import { postHref } from '@/lib/posts';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">个人博客</p>
      <h1>{site.title}</h1>
      <p>{site.description}</p>
      <div class="hero-actions">
        <a class="button primary" href="/blog/">阅读文章</a>
        <a class="button secondary" href="/about/">认识我</a>
      </div>
    </div>
    <figure class="hero-visual">
      <picture>
        <source srcset="/images/blog-hero.webp" type="image/webp" />
        <img src="/images/blog-hero.png" alt="阳光下的书桌、笔记本和代码屏幕" width="1680" height="945" />
      </picture>
    </figure>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">最新文章</p>
      <h2>最近记录</h2>
      <a class="text-link" href="/blog/">查看全部</a>
    </div>
    <div class="post-grid">
      {
        posts.map((post) => (
          <article class="post-card">
            <p class="post-date">
              {post.data.publishDate.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </p>
            <h3><a href={postHref(post)}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <ul class="tag-list">
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section split">
    <div>
      <p class="eyebrow">写作方向</p>
      <h2>把输入变成长期可检索的输出</h2>
    </div>
    <div class="feature-list">
      <p>技术笔记：框架、工具链、工程实践与踩坑记录。</p>
      <p>项目复盘：从构想到上线，记录每一次迭代的判断。</p>
      <p>生活思考：阅读、表达、效率和那些会慢慢发光的小观察。</p>
    </div>
  </section>
</BaseLayout>
