---
import MusicPlayer from '@/components/MusicPlayer.astro';
import { site } from '@/data/site';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const pageTitle = title === site.title ? title : `${title} | ${site.name}`;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <nav class="nav" aria-label="主导航">
        <a class="brand" href="/" aria-label={site.title}>
          <span class="brand-mark">天</span>
          <span>{site.name}</span>
        </a>
        <div class="nav-links">
          {
            site.nav.map((item) => {
              const hrefPath = item.href.replace(/\/$/, '') || '/';
              const isActive = currentPath === hrefPath || (hrefPath !== '/' && currentPath.startsWith(hrefPath));
              return (
                <a href={item.href} aria-current={isActive ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })
          }
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {site.author}. Build by Astro.</p>
      <nav class="footer-links" aria-label="第三方链接">
        {
          site.externalLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.label}
            </a>
          ))
        }
      </nav>
    </footer>
    <MusicPlayer />
  </body>
</html>
